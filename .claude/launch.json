{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "autotube",
      "runtimeExecutable": ".venv/bin/uvicorn",
      "runtimeArgs": ["backend.main:app", "--host", "0.0.0.0", "--port", "8000", "--reload"],
      "port": 8000
    },
    {
      "name": "autotube-frontend",
      "runtimeExecutable": "/usr/local/bin/python3",
      "runtimeArgs": ["-m", "http.server", "3456", "--directory", "frontend"],
      "port": 3456
    }
  ]
}
